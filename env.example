# Copy to .env at the repo root and fill in. Never commit the result.
#
#   cp env.example .env
#
# Generate all three secrets at once:
#   node -e "const c=require('crypto');for(const k of ['JWT_SECRET','JWT_REFRESH_SECRET'])console.log(k+'='+c.randomBytes(32).toString('base64url'));console.log('SETTINGS_ENCRYPTION_KEY='+c.randomBytes(32).toString('hex'))"

# Signs short-lived access tokens. Any string >= 16 chars; 32 random bytes is right.
JWT_SECRET=

# Signs the httpOnly refresh cookie. Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=

# AES-256-GCM key for stored AI-provider API keys. EXACTLY 64 hex characters.
# Change this and existing provider keys become undecryptable - re-enter them.
SETTINGS_ENCRYPTION_KEY=

# Where the browser loads the UI from. Must match exactly, scheme and port included.
CORS_ORIGIN=http://localhost:8080

# Host port for the web UI.
WEB_PORT=8080

# Set to true once you are behind HTTPS, so the refresh cookie is Secure.
COOKIE_SECURE=false

# ---- Local (non-Docker) development only -----------------------------------
# NODE_ENV=development
# PORT=4000
# MONGO_URI=mongodb://localhost:27017/ai-usage

# ---- Optional tuning (defaults shown) --------------------------------------
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# PRICING_CACHE_TTL_MS=300000
# DASHBOARD_CACHE_TTL_MS=60000
# AI_SEARCH_CACHE_TTL_MS=86400000
# AI_REQUEST_TIMEOUT_MS=30000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_USAGE_MAX=240
